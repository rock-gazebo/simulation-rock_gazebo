<sdf version="1.8">
<world name="w">
    <model name="m">
        <link name="root">
            <inertial>
                <mass>2</mass>
            </inertial>
        </link>

        <link name="rotated_link">
            <inertial>
                <mass>0.01</mass>
            </inertial>
        </link>

        <joint name="rotated2root" type="fixed">
            <pose>0 0 0 0 1.5708 0</pose>
            <parent>root</parent>
            <child>rotated_link</child>
        </joint>

        <plugin filename="gz_rock-plugintask" name="gz_rock::PluginTask">
            <task model="gz_rock::ModelTask" />
        </plugin>
    </model>
</world>
</sdf>


