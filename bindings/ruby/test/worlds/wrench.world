<sdf version="1.8">
    <world name="w">
        <model name="m">
            <link name="root">
                <pose>1 0 0 0 0 0</pose>
            </link>
            <link name="middle">
                <pose>2 0 0 0 0 0</pose>
            </link>
            <link name="leaf">
                <pose>3 0 0 0 0 0</pose>
            </link>
            <link name="ground">
                <must_be_base_link>true</must_be_base_link>
            </link>
            <joint name="attach_to_ground" type="fixed">
                <parent>ground</parent>
                <child>root</child>
            </joint>
            <joint name="root2middle" type="revolute">
                <parent>root</parent>
                <child>middle</child>
                <axis>
                    <xyz>0 0 1</xyz>
                    <limit>
                        <lower>-0.1</lower>
                        <upper>0.1</upper>
                    </limit>
                </axis>
            </joint>
            <joint name="middle2leaf" type="revolute">
                <parent>middle</parent>
                <child>leaf</child>
                <axis>
                    <xyz>0 0 1</xyz>
                    <limit>
                        <lower>-0.1</lower>
                        <upper>0.1</upper>
                    </limit>
                </axis>
            </joint>

            <plugin filename="gz_rock-plugintask" name="gz_rock::PluginTask">
                <task model="gz_rock::ModelTask" />
            </plugin>
        </model>
    </world>
</sdf>



