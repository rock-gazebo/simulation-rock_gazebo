<sdf version="1.8">
<world name="w">
    <physics type="ode" default="1">
        <max_step_size>0.1</max_step_size>
        <real_time_update_rate>10</real_time_update_rate>
    </physics>

    <spherical_coordinates>
        <surface_model>EARTH_WGS84</surface_model>
        <latitude_deg>-22.9068</latitude_deg>
        <longitude_deg>-43.1729</longitude_deg>
        <elevation>10</elevation>
        <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <plugin name="gz::sim::systems::NavSat" filename="gz-sim-navsat-system"></plugin>

    <model name="m">
        <static>true</static>
        <link name="l">
            <sensor name="g" type="navsat">
                <plugin name="rock_gazebo::PluginTask" filename="rock_gazebo">
                    <task model="rock_gazebo::GPSTask" />
                </plugin>
            </sensor>
        </link>
    </model>
</world>
</sdf>
