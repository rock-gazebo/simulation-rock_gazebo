<sdf version="1.8">
<world name="w">
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system"></plugin>

    <model name="m">
        <link name="l">
            <sensor name="i" type="imu">
                <update_rate>5</update_rate>
                <plugin name="gz_rock::PluginTask" filename="gz_rock-plugintask">
                    <task model="gz_rock::ImuTask" />
                </plugin>
            </sensor>
        </link>
    </model>
</world>
</sdf>

