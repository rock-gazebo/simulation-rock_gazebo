<sdf version="1.8">
    <world name="w">
        <physics type="ode" default="1">
            <max_step_size>0.1</max_step_size>
            <real_time_update_rate>10</real_time_update_rate>
        </physics>

        <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system"></plugin>

        <model name="m">
            <link name="l">
                <sensor name="laser" type="gpu_lidar">
                    <ray>
                        <scan>
                            <horizontal>
                                <samples>10</samples>
                                <resolution>1</resolution>
                                <min_angle>-3.1415</min_angle>
                                <max_angle>3.1415</max_angle>
                            </horizontal>
                            <vertical>
                                <samples>3</samples>
                                <resolution>1</resolution>
                                <min_angle>-0.1963</min_angle>
                                <max_angle>0.1963</max_angle>
                            </vertical>
                        </scan>

                        <range>
                            <min>1</min>
                            <max>200</max>
                            <resolution>0.02</resolution>
                        </range>
                    </ray>

                    <plugin name="rock_gazebo::PluginTask" filename="rock_gazebo">
                        <task model="rock_gazebo::LaserScanTask" />
                    </plugin>
                </sensor>
            </link>
        </model>
    </world>
</sdf>
