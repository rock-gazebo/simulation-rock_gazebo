<sdf version="1.8">
<world name="w">
    <physics type="ode" default="1">
    <max_step_size>0.02</max_step_size>
    <real_time_update_rate>50</real_time_update_rate>
    </physics>

    <model name="m">
        <link name="root" />
        <link name="00" />
        <link name="01" />
        <link name="02" />
        <link name="child_00" />
        <link name="child_01" />
        <link name="child_02" />

        <plugin filename="gz_rock-plugintask" name="gz_rock::PluginTask">
            <task model="gz_rock::ModelTask" />
        </plugin>

        <joint name="j_00" type="revolute">
            <parent>root</parent>
            <child>00</child>
            <axis>
                <xyz>1 0 0</xyz>
                <limit>
                    <lower>0</lower>
                    <upper>0.1</upper>
                </limit>
            </axis>
        </joint>

        <joint name="j_01" type="revolute">
            <parent>root</parent>
            <child>01</child>
            <axis>
                <xyz>1 0 0</xyz>
                <limit>
                    <lower>0.2</lower>
                    <upper>0.3</upper>
                </limit>
            </axis>
        </joint>

        <joint name="j_02" type="fixed">
            <parent>root</parent>
            <child>02</child>
        </joint>

        <joint name="child_j_00" type="revolute">
            <parent>root</parent>
            <child>child_00</child>
            <axis>
                <xyz>1 0 0</xyz>
                <limit>
                    <lower>0.4</lower>
                    <upper>0.5</upper>
                </limit>
            </axis>
        </joint>

        <joint name="child_j_01" type="revolute">
            <parent>root</parent>
            <child>child_01</child>
            <axis>
                <xyz>1 0 0</xyz>
                <limit>
                    <lower>0.6</lower>
                    <upper>0.7</upper>
                </limit>
            </axis>
        </joint>

        <joint name="child_j_02" type="fixed">
            <parent>root</parent>
            <child>child_02</child>
        </joint>

        <joint name="fixed_base" type="fixed">
            <parent>world</parent>
            <child>root</child>
        </joint>
    </model>
</world>
</sdf>


