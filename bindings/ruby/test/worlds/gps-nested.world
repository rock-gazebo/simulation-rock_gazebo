<sdf version="1.6">
<world name="w">
    <spherical_coordinates>
        <surface_model>EARTH_WGS84</surface_model>
        <latitude_deg>-22.9068</latitude_deg>
        <longitude_deg>-43.1729</longitude_deg>
        <elevation>10</elevation>
        <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <plugin name="gz::sim::systems::NavSat" filename="gz-sim-navsat-system"></plugin>

    <model name="m">
        <static>true</static>
        <link name="root" />

        <include>
            <name>nested</name>
            <uri>model://gps</uri>
        </include>

        <joint name="nested2root" type="fixed">
            <parent>root</parent>
            <child>nested::l</child>
        </joint>
    </model>
</world>
</sdf>
