<sdf version="1.8">
<world name="w">
    <physics type="ode" default="1">
        <max_step_size>0.1</max_step_size>
        <real_time_update_rate>10</real_time_update_rate>
    </physics>

    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system"></plugin>

    <model name="m">
        <link name="l">
            <sensor name="c" type="camera">
                <camera>
                    <image>
                        <width>20</width>
                        <height>20</height>
                    </image>
                </camera>
                <update_rate>5</update_rate>

                <plugin name="gz_rock::PluginTask" filename="gz_rock-plugintask">
                    <task model="gz_rock::CameraTask" />
                </plugin>
            </sensor>
        </link>
    </model>
</world>
</sdf>
